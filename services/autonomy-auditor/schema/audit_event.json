{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Audit Event Schema",
  "required": ["id", "timestamp", "event", "immutable"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique audit event identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp in ISO format"
    },
    "event": {
      "type": "string",
      "enum": ["proposal_generated", "proposal_refined", "proposal_applied", "proposal_rolled_back", "simulation_run"],
      "description": "Type of audit event"
    },
    "proposal_id": {
      "type": "string",
      "description": "Related proposal identifier"
    },
    "mode": {
      "type": "string",
      "enum": ["SIMULATION", "LIVE"],
      "description": "Execution mode"
    },
    "metadata": {
      "type": "object",
      "description": "Additional event metadata"
    },
    "simulation_mode": {
      "type": "boolean",
      "description": "Whether system was in simulation mode"
    },
    "immutable": {
      "type": "boolean",
      "const": true,
      "description": "Audit events are immutable"
    }
  }
}