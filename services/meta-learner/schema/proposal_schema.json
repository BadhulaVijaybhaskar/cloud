{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Meta Proposal Schema",
  "required": ["id", "type", "confidence", "expected_gain", "explainability_ref", "rollback_id"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique proposal identifier"
    },
    "type": {
      "type": "string",
      "enum": ["scaling_optimization", "resource_reallocation", "performance_tuning", "cost_optimization"],
      "description": "Type of optimization proposal"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score for the proposal"
    },
    "expected_gain": {
      "type": "string",
      "description": "Expected improvement from applying proposal"
    },
    "explainability_ref": {
      "type": "string",
      "description": "Reference to explainability artifact"
    },
    "rollback_id": {
      "type": "string",
      "description": "Identifier for rollback capability"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "Proposal creation timestamp"
    },
    "simulation_mode": {
      "type": "boolean",
      "description": "Whether proposal was generated in simulation mode"
    },
    "source_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Patterns that led to this proposal"
    }
  }
}