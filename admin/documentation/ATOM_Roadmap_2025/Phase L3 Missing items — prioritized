## 3) mTLS production certificate bootstrap + validate (Vault PKI or external CA)

**Path:** `infra/scripts/l3/mtls_bootstrap.sh` (executable)

```bash
#!/usr/bin/env bash
set -euo pipefail
# infra/scripts/l3/mtls_bootstrap.sh
# Bootstraps mTLS certs (simulation-safe). Integrates with Vault PKI if available.

SIMULATION_MODE=${SIMULATION_MODE:-true}
VAULT_ADDR=${VAULT_ADDR:-"https://vault.atom.internal"}
PKI_ROLE=${PKI_ROLE:-"l3-pki-role"}
CERT_DIR="infra/security/certs"
LOG="reports/l3/mtls_bootstrap.log"

mkdir -p "$CERT_DIR" reports/l3

echo "mTLS bootstrap start (SIMULATION_MODE=${SIMULATION_MODE})" | tee "$LOG"

services=(l3-orchestrator l3-gateway l3-metadata l3-bus l3-auditor)

for svc in "${services[@]}"; do
  cn="${svc}.atom.internal"
  key="${CERT_DIR}/${svc}.key.pem"
  csr="${CERT_DIR}/${svc}.csr.pem"
  crt="${CERT_DIR}/${svc}.crt.pem"

  if [ "$SIMULATION_MODE" = "true" ]; then
    echo "SIM: Generating self-signed cert for ${cn}" | tee -a "$LOG"
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
      -subj "/CN=${cn}/O=atom" \
      -keyout "${key}" -out "${crt}" 2>/dev/null
    echo "SIM: cert for ${svc} written to ${crt}" | tee -a "$LOG"
  else
    # Example using Vault PKI (requires Vault configured)
    echo "Requesting cert for ${cn} from Vault PKI role ${PKI_ROLE}" | tee -a "$LOG"
    vault write -format=json pki/issue/"${PKI_ROLE}" common_name="${cn}" ttl=8760h \
      > "${CERT_DIR}/${svc}.json"
    jq -r .data.certificate < "${CERT_DIR}/${svc}.json" > "${crt}"
    jq -r .data.private_key < "${CERT_DIR}/${svc}.json" > "${key}"
    echo "Certificate issued and saved to ${crt}" | tee -a "$LOG"
  fi
done

echo "mTLS bootstrap complete." | tee -a "$LOG"
```

