{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecisionRecordV1",
  "type": "object",
  "required": ["decision_id", "timestamp", "decision_type", "outcome", "provenance"],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^dec-[a-zA-Z0-9-]+$",
      "description": "Unique decision identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Decision timestamp"
    },
    "decision_type": {
      "type": "string",
      "enum": ["consensus", "arbitration", "policy", "human_review"],
      "description": "Type of decision"
    },
    "outcome": {
      "type": "object",
      "required": ["action", "confidence"],
      "properties": {
        "action": {
          "type": "string",
          "description": "Decided action"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Decision confidence score"
        },
        "rationale": {
          "type": "string",
          "description": "Human-readable rationale"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["voters", "method"],
      "properties": {
        "voters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "voter_id": {"type": "string"},
              "vote": {"type": "string"},
              "weight": {"type": "number"}
            }
          }
        },
        "method": {
          "type": "string",
          "enum": ["majority", "weighted", "consensus", "arbiter"]
        },
        "input_signals": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tenant_id": {"type": "string"},
        "region": {"type": "string"},
        "policy_context": {"type": "string"}
      }
    }
  }
}